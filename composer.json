{
    "name": "app/torneo-futbol-slim",
    "description": "Sistema de gestión para torneo infantil de fútbol",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "slim/slim": "^4.15",
        "slim/psr7": "^1.8",
        "php-di/php-di": "^7.1",
        "slim/twig-view": "^3.4",
        "vlucas/phpdotenv": "^5.7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "dev": "php -S localhost:8000 -t public"
    },
    "config": {
        "process-timeout": 0,
        "sort-packages": true
    }
}
