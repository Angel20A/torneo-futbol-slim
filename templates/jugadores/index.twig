{% extends 'layouts/base.twig' %}

{% block title %}Jugadores | {{ appName }}{% endblock %}

{% block content %}
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a href="{{ url_for('home') }}" class="text-decoration-none text-muted">Inicio</a></li>
                <li class="breadcrumb-item active" aria-current="page">Jugadores</li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-0 text-dark">
            <i class="bi bi-people-fill text-primary me-2"></i>Gestión de Jugadores
        </h2>
        <p class="text-muted small mb-0">Control de fichas de jugadores infantiles, asignación de equipos y edades.</p>
    </div>

    <div>
        <a href="{{ url_for('jugadores.create') }}" class="btn btn-primary shadow-sm rounded-3 px-3 py-2 fw-medium">
            <i class="bi bi-person-plus-fill me-1"></i> Registrar Jugador
        </a>
    </div>
</div>

<!-- Filtros de Búsqueda y Equipo -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="GET" action="{{ url_for('jugadores.index') }}" class="row g-2 align-items-center">
            <!-- Filtro por Equipo -->
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted">
                        <i class="bi bi-shield-shaded"></i>
                    </span>
                    <select name="id_equipo" class="form-select border-start-0" onchange="this.form.submit()">
                        <option value="">-- Todos los Equipos --</option>
                        {% for eq in equipos %}
                            <option value="{{ eq.id_equipo }}" {% if selected_equipo == eq.id_equipo %}selected{% endif %}>
                                {{ eq.nombre }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
            </div>

            <!-- Búsqueda por texto -->
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" 
                           name="q" 
                           class="form-control border-start-0" 
                           placeholder="Buscar por nombre, apellido o club..." 
                           value="{{ busqueda|default('') }}">
                </div>
            </div>

            <!-- Botones -->
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-secondary flex-grow-1 rounded-3">
                    Filtrar
                </button>
                {% if selected_equipo or busqueda %}
                    <a href="{{ url_for('jugadores.index') }}" class="btn btn-outline-secondary rounded-3" title="Limpiar filtros">
                        <i class="bi bi-x-lg"></i>
                    </a>
                {% endif %}
            </div>
        </form>
    </div>
</div>

{% if jugadores is empty %}
    <div class="card border-0 shadow-sm rounded-4 p-5 text-center">
        <div class="my-4">
            <i class="bi bi-person-slash display-1 text-muted opacity-50 mb-3 d-block"></i>
            <h4 class="fw-bold text-secondary">No se encontraron jugadores</h4>
            <p class="text-muted small">
                {% if selected_equipo or busqueda %}
                    No hay resultados que coincidan con los filtros aplicados.
                {% else %}
                    Aún no hay jugadores inscritos en el torneo.
                {% endif %}
            </p>
            {% if selected_equipo or busqueda %}
                <a href="{{ url_for('jugadores.index') }}" class="btn btn-outline-secondary rounded-pill px-4 mt-2">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Restablecer Filtros
                </a>
            {% else %}
                <a href="{{ url_for('jugadores.create') }}" class="btn btn-primary rounded-pill px-4 mt-2">
                    <i class="bi bi-plus-lg me-1"></i> Inscribir Primer Jugador
                </a>
            {% endif %}
        </div>
    </div>
{% else %}
    <!-- Tabla de Jugadores Moderna -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary small text-uppercase fw-semibold">
                    <tr>
                        <th class="ps-4" style="width: 70px;">Foto</th>
                        <th>Jugador</th>
                        <th>Equipo</th>
                        <th>Nacimiento / Edad</th>
                        <th>Fecha Registro</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y">
                    {% for j in jugadores %}
                        <tr>
                            <!-- Avatar -->
                            <td class="ps-4">
                                <img src="{{ j.foto_url }}" 
                                     alt="{{ j.nombres }}" 
                                     class="rounded-circle shadow-sm border border-2 border-white object-fit-cover" 
                                     width="48" 
                                     height="48" 
                                     onerror="this.onerror=null;this.src='https://placehold.co/48x48/ced4da/495057?text=Foto';">
                            </td>

                            <!-- Nombre Completo -->
                            <td>
                                <div class="fw-bold text-dark">{{ j.nombres }} {{ j.apellidos }}</div>
                                <span class="badge bg-light text-muted border px-2 py-0.5 rounded-pill font-monospace small">
                                    ID #{{ j.id_jugador }}
                                </span>
                            </td>

                            <!-- Equipo -->
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    {% if j.equipo_foto_url %}
                                        <img src="{{ j.equipo_foto_url }}" alt="{{ j.equipo_nombre }}" class="team-logo-sm rounded-2">
                                    {% else %}
                                        <i class="bi bi-shield-fill text-muted"></i>
                                    {% endif %}
                                    <span class="fw-medium text-secondary">{{ j.equipo_nombre }}</span>
                                </div>
                            </td>

                            <!-- Fecha Nacimiento / Edad -->
                            <td>
                                <div class="fw-medium text-dark">{{ j.fecha_nacimiento|date("d/m/Y") }}</div>
                                <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill small">
                                    {{ j.edad }} años
                                </span>
                            </td>

                            <!-- Fecha Registro -->
                            <td class="text-muted small">
                                {{ j.creado_en|date("d/m/Y") }}
                            </td>

                            <!-- Acciones -->
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm">
                                    <a href="/jugadores/{{ j.id_jugador }}/editar" class="btn btn-outline-primary" title="Editar Jugador">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>

                                    <form action="/jugadores/{{ j.id_jugador }}/eliminar" method="POST" class="d-inline" onsubmit="return confirm('¿Está seguro de eliminar a {{ j.nombres|e('js') }} {{ j.apellidos|e('js') }}?');">
                                        <button type="submit" class="btn btn-outline-danger" title="Eliminar Jugador">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-white border-top py-3 px-4 d-flex justify-content-between align-items-center">
            <span class="text-muted small">Mostrando <strong>{{ jugadores|length }}</strong> jugador(es) en total</span>
        </div>
    </div>
{% endif %}
{% endblock %}
