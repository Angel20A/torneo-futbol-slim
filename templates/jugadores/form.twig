{% extends 'layouts/base.twig' %}

{% set isEdit = jugador.id_jugador is defined and jugador.id_jugador %}
{% block title %}{{ title }} | {{ appName }}{% endblock %}

{% block content %}
<div class="row justify-content-center">
    <div class="col-lg-7 col-md-9">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item"><a href="{{ url_for('home') }}" class="text-decoration-none text-muted">Inicio</a></li>
                <li class="breadcrumb-item"><a href="{{ url_for('jugadores.index') }}" class="text-decoration-none text-muted">Jugadores</a></li>
                <li class="breadcrumb-item active" aria-current="page">{{ isEdit ? 'Editar' : 'Registrar' }}</li>
            </ol>
        </nav>

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-header bg-white border-bottom p-4">
                <div class="d-flex align-items-center gap-3">
                    <span class="p-2.5 rounded-3 bg-primary-subtle text-primary fs-4">
                        <i class="bi bi-person-badge"></i>
                    </span>
                    <div>
                        <h4 class="fw-bold mb-0 text-dark">{{ isEdit ? 'Editar Ficha de Jugador' : 'Inscribir Nuevo Jugador' }}</h4>
                        <small class="text-muted">{{ isEdit ? 'Actualice la información del jugador o cambie de club' : 'Ingrese los datos del menor para habilitarlo en la competición' }}</small>
                    </div>
                </div>
            </div>

            <div class="card-body p-4">
                {% if errors is not empty %}
                    <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
                        <div class="d-flex align-items-center mb-1">
                            <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i>
                            <strong>Por favor corrija los siguientes errores:</strong>
                        </div>
                        <ul class="mb-0 ps-4 small">
                            {% for err in errors %}
                                <li>{{ err }}</li>
                            {% endfor %}
                        </ul>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                {% endif %}

                {% if equipos is empty %}
                    <div class="alert alert-warning rounded-3 mb-4">
                        <i class="bi bi-exclamation-circle-fill me-2"></i>
                        No existen equipos registrados aún. Debe crear al menos un equipo antes de inscribir jugadores.
                        <div class="mt-2">
                            <a href="{{ url_for('equipos.create') }}" class="btn btn-sm btn-warning">Crear Equipo</a>
                        </div>
                    </div>
                {% endif %}

                <form action="{{ isEdit ? '/jugadores/' ~ jugador.id_jugador ~ '/editar' : '/jugadores' }}" method="POST" enctype="multipart/form-data" novalidate>
                    <!-- Selección de Equipo -->
                    <div class="mb-3">
                        <label for="id_equipo" class="form-label fw-semibold text-secondary">
                            Club / Equipo Perteneciente <span class="text-danger">*</span>
                        </label>
                        <select class="form-select form-select-lg rounded-3 fs-6" id="id_equipo" name="id_equipo" required>
                            <option value="">-- Seleccionar Equipo --</option>
                            {% for eq in equipos %}
                                <option value="{{ eq.id_equipo }}" {% if jugador.id_equipo|default(0) == eq.id_equipo %}selected{% endif %}>
                                    {{ eq.nombre }}
                                </option>
                            {% endfor %}
                        </select>
                        <div class="form-text">Asigna el equipo infantil en el que jugará durante el torneo.</div>
                    </div>

                    <div class="row g-3 mb-3">
                        <!-- Nombres -->
                        <div class="col-md-6">
                            <label for="nombres" class="form-label fw-semibold text-secondary">
                                Nombres <span class="text-danger">*</span>
                            </label>
                            <input type="text" 
                                   class="form-control rounded-3" 
                                   id="nombres" 
                                   name="nombres" 
                                   value="{{ jugador.nombres|default('') }}" 
                                   placeholder="Ej. Lionel Andrés" 
                                   maxlength="100" 
                                   required>
                        </div>

                        <!-- Apellidos -->
                        <div class="col-md-6">
                            <label for="apellidos" class="form-label fw-semibold text-secondary">
                                Apellidos <span class="text-danger">*</span>
                            </label>
                            <input type="text" 
                                   class="form-control rounded-3" 
                                   id="apellidos" 
                                   name="apellidos" 
                                   value="{{ jugador.apellidos|default('') }}" 
                                   placeholder="Ej. Messi Cuccittini" 
                                   maxlength="100" 
                                   required>
                        </div>
                    </div>

                    <!-- Fecha de Nacimiento -->
                    <div class="mb-3">
                        <label for="fecha_nacimiento" class="form-label fw-semibold text-secondary">
                            Fecha de Nacimiento <span class="text-danger">*</span>
                        </label>
                        <input type="date" 
                               class="form-control rounded-3" 
                               id="fecha_nacimiento" 
                               name="fecha_nacimiento" 
                               value="{{ jugador.fecha_nacimiento|default('') }}" 
                               max="{{ 'now'|date('Y-m-d') }}" 
                               required>
                        <div class="form-text">Permite verificar la categoría etaria del jugador infantil.</div>
                    </div>

                    <!-- Fotografía del Jugador -->
                    <div class="mb-4">
                        <label for="foto" class="form-label fw-semibold text-secondary">
                            Fotografía de la Ficha <span class="text-danger">{% if not isEdit %}*{% endif %}</span>
                        </label>
                        <input type="file" 
                               class="form-control rounded-3" 
                               id="foto" 
                               name="foto" 
                               accept="image/png, image/jpeg, image/webp, image/avif" 
                               onchange="previewPlayerImage(event)" 
                               {% if not isEdit %}required{% endif %}>
                        <div class="form-text">Fotografía tipo carnet o deportiva del menor (JPG, PNG, WEBP, AVIF).</div>

                        <!-- Vista Previa -->
                        <div class="mt-3 text-center p-3 bg-light rounded-3 border">
                            <div class="small text-muted mb-2 fw-medium">Vista previa de la foto:</div>
                            <img id="playerImagePreview" 
                                 src="{{ jugador.foto_url|default('') ?: 'https://placehold.co/120x120/ced4da/495057?text=Foto' }}" 
                                 alt="Foto del Jugador" 
                                 class="rounded-circle shadow-sm border border-2 border-white object-fit-cover" 
                                 style="width: 100px; height: 100px;">
                        </div>
                    </div>

                    <!-- Botones de Acción -->
                    <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                        <a href="{{ url_for('jugadores.index') }}" class="btn btn-light rounded-3 px-4 fw-medium">
                            Cancelar
                        </a>
                        <button type="submit" class="btn btn-primary rounded-3 px-4 fw-medium shadow-sm" {% if equipos is empty %}disabled{% endif %}>
                            <i class="bi bi-check2-circle me-1"></i> {{ isEdit ? 'Actualizar Jugador' : 'Guardar Jugador' }}
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
function previewPlayerImage(event) {
    const file = event.target.files[0];
    if (file) {
        const preview = document.getElementById('playerImagePreview');
        preview.src = URL.createObjectURL(file);
    }
}
</script>
{% endblock %}
