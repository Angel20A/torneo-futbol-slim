{% extends 'layouts/base.twig' %}

{% block title %}Jornadas | {{ appName }}{% endblock %}

{% block content %}
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a href="{{ url_for('home') }}" class="text-decoration-none text-muted">Inicio</a></li>
                <li class="breadcrumb-item"><a href="{{ url_for('partidos.index') }}" class="text-decoration-none text-muted">Partidos</a></li>
                <li class="breadcrumb-item active" aria-current="page">Jornadas</li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-0 text-dark">
            <i class="bi bi-flag-fill text-info me-2"></i>Gestión de Jornadas
        </h2>
        <p class="text-muted small mb-0">Catálogo de jornadas y fechas de juego del torneo. Cada partido se programa dentro de una jornada.</p>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <a href="{{ url_for('partidos.index') }}" class="btn btn-light shadow-sm rounded-3 px-3 py-2 fw-medium">
            <i class="bi bi-arrow-left me-1"></i> Volver a Partidos
        </a>
        <a href="{{ url_for('jornadas.create') }}" class="btn btn-info text-white shadow-sm rounded-3 px-3 py-2 fw-medium">
            <i class="bi bi-plus-circle me-1"></i> Registrar Jornada
        </a>
    </div>
</div>

{% if jornadas is empty %}
    <div class="card border-0 shadow-sm rounded-4 p-5 text-center">
        <div class="my-4">
            <i class="bi bi-flag display-1 text-muted opacity-50 mb-3 d-block"></i>
            <h4 class="fw-bold text-secondary">No hay jornadas habilitadas</h4>
            <p class="text-muted small">Habilite las jornadas y fechas de juego al inicio del torneo para poder programar partidos.</p>
            <a href="{{ url_for('jornadas.create') }}" class="btn btn-info text-white rounded-pill px-4 mt-2">
                <i class="bi bi-plus-lg me-1"></i> Crear Primera Jornada
            </a>
        </div>
    </div>
{% else %}
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary small text-uppercase fw-semibold">
                    <tr>
                        <th class="ps-4">Jornada</th>
                        <th>Fecha de juego</th>
                        <th>Descripción</th>
                        <th class="text-center">Partidos</th>
                        <th class="text-center">Estado</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    {% for j in jornadas %}
                        {% set tieneRegistros = (j.total_partidos + j.total_suspensiones) > 0 %}
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="p-2 rounded-3 bg-info-subtle text-info"><i class="bi bi-flag-fill"></i></span>
                                    <span class="fw-bold text-dark">Jornada {{ j.numero_jornada }}</span>
                                </div>
                            </td>

                            <td>
                                <span class="fw-medium text-dark"><i class="bi bi-calendar3 text-muted me-1"></i>{{ j.fecha_juego|date("d/m/Y") }}</span>
                            </td>

                            <td class="text-secondary">
                                {% if j.descripcion %}{{ j.descripcion }}{% else %}<span class="text-muted fst-italic">Sin descripción</span>{% endif %}
                            </td>

                            <td class="text-center">
                                {% if j.total_partidos > 0 %}
                                    <a href="{{ url_for('partidos.index') }}?id_jornada={{ j.id_jornada }}" class="badge bg-info-subtle text-info border border-info-subtle rounded-pill text-decoration-none" title="Ver los partidos de esta jornada">
                                        {{ j.total_partidos }} {{ j.total_partidos == 1 ? 'partido' : 'partidos' }}
                                    </a>
                                {% else %}
                                    <span class="badge bg-secondary-subtle text-muted rounded-pill">Sin partidos</span>
                                {% endif %}
                            </td>

                            <td class="text-center">
                                {% if j.estado == 'hoy' %}
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill">Hoy</span>
                                {% elseif j.estado == 'realizada' %}
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">Realizada</span>
                                {% else %}
                                    <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill">Próxima</span>
                                {% endif %}
                            </td>

                            <td class="text-end pe-4">
                                <div class="d-flex justify-content-end gap-2">
                                    <a href="{{ url_for('partidos.index') }}?id_jornada={{ j.id_jornada }}" class="btn btn-sm btn-outline-info rounded-3 px-2.5" title="Ver partidos de la jornada">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a href="{{ url_for('jornadas.edit', {'id': j.id_jornada}) }}" class="btn btn-sm btn-outline-primary rounded-3 px-2.5" title="Editar Jornada">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    {% if tieneRegistros %}
                                        <span class="d-inline-block" title="No se puede eliminar: tiene partidos o suspensiones asignados">
                                            <button type="button" class="btn btn-sm btn-outline-danger rounded-3 px-2.5" disabled>
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </span>
                                    {% else %}
                                        <button type="button" class="btn btn-sm btn-outline-danger rounded-3 px-2.5" title="Eliminar Jornada"
                                                data-bs-toggle="modal" data-bs-target="#modalEliminar"
                                                data-action="{{ url_for('jornadas.delete', {'id': j.id_jornada}) }}"
                                                data-jornada="Jornada {{ j.numero_jornada }} ({{ j.fecha_juego|date('d/m/Y') }})">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-white border-top py-3 px-4">
            <span class="text-muted small">Mostrando <strong>{{ jornadas|length }}</strong> {{ jornadas|length == 1 ? 'jornada' : 'jornadas' }} en total</span>
        </div>
    </div>
{% endif %}

<!-- Modal de confirmación para eliminar -->
<div class="modal fade" id="modalEliminar" tabindex="-1" aria-labelledby="modalEliminarLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-body p-4 text-center">
                <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-danger-subtle text-danger mb-3" style="width: 64px; height: 64px;">
                    <i class="bi bi-trash3 fs-2"></i>
                </span>
                <h5 class="fw-bold text-dark mb-2" id="modalEliminarLabel">¿Eliminar esta jornada?</h5>
                <p class="text-muted mb-1">Se eliminará la <strong id="modalEliminarNombre" class="text-dark"></strong>.</p>
                <p class="text-muted small mb-4">Esta acción es irreversible.</p>
                <form id="formEliminar" method="POST" action="" class="d-flex justify-content-center gap-2">
                    <button type="button" class="btn btn-light rounded-3 px-4 fw-medium" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger rounded-3 px-4 fw-medium shadow-sm">
                        <i class="bi bi-trash3 me-1"></i> Sí, eliminar
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
document.getElementById('modalEliminar').addEventListener('show.bs.modal', function (event) {
    const boton = event.relatedTarget;
    document.getElementById('formEliminar').setAttribute('action', boton.getAttribute('data-action'));
    document.getElementById('modalEliminarNombre').textContent = boton.getAttribute('data-jornada');
});
</script>
{% endblock %}