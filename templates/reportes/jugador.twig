{% extends 'layouts/base.twig' %}

{% block title %}{{ title }} | {{ appName }}{% endblock %}

{% block styles %}
<style>
    .player-profile-card {
        background: #ffffff;
        border-radius: 1.25rem;
        border: 1px solid rgba(0,0,0,0.06);
    }
    .profile-photo-hero {
        width: 160px;
        height: 160px;
        object-fit: cover;
        border-radius: 1.25rem;
        border: 4px solid #ffffff;
        box-shadow: 0 8px 24px rgba(0,0,0,0.12);
    }
    .status-pill-ok {
        background-color: #d1e7dd;
        color: #0f5132;
        border: 1px solid #badbcc;
        font-weight: 600;
    }
    .status-pill-danger {
        background-color: #f8d7da;
        color: #842029;
        border: 1px solid #f5c2c7;
        font-weight: 700;
    }
    .kpi-box {
        background: #f8f9fa;
        border-radius: 1rem;
        padding: 1.1rem;
        border: 1px solid #e9ecef;
        text-align: center;
        transition: transform 0.2s ease;
    }
    .kpi-box:hover {
        transform: translateY(-3px);
        background: #ffffff;
        box-shadow: 0 6px 16px rgba(0,0,0,0.06);
    }
    .nav-tabs .nav-link {
        font-weight: 600;
        color: #6c757d;
        border: none;
        border-bottom: 3px solid transparent;
        padding: 0.75rem 1.25rem;
    }
    .nav-tabs .nav-link.active {
        color: #198754;
        border-color: #198754;
        background: transparent;
    }
    @media print {
        .navbar, .footer, .no-print, .btn, .breadcrumb {
            display: none !important;
        }
        body {
            background-color: #ffffff !important;
        }
        .player-profile-card {
            border: 1px solid #000 !important;
            box-shadow: none !important;
        }
    }
</style>
{% endblock %}

{% block content %}
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 no-print">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a href="{{ url_for('home') }}" class="text-decoration-none text-muted">Inicio</a></li>
                <li class="breadcrumb-item"><a href="{{ url_for('reportes.index') }}" class="text-decoration-none text-muted">Reportes</a></li>
                <li class="breadcrumb-item active" aria-current="page">Consulta de Jugador</li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-0 text-dark">
            <i class="bi bi-person-vcard-fill text-info me-2"></i>Consulta en Pantalla de Jugador
        </h2>
        <p class="text-muted small mb-0">Expediente técnico, datos personales, registro disciplinario e historial de goleo.</p>
    </div>

    <div class="d-flex align-items-center gap-2">
        <button type="button" onclick="window.print()" class="btn btn-outline-dark shadow-sm rounded-3 fw-medium">
            <i class="bi bi-printer me-1"></i> Imprimir Ficha
        </button>
        <a href="{{ url_for('reportes.index') }}" class="btn btn-light border shadow-sm rounded-3">
            <i class="bi bi-arrow-left me-1"></i> Volver a Reportes
        </a>
    </div>
</div>

<!-- Selector Rápido de Jugador -->
<div class="card border-0 shadow-sm rounded-4 mb-4 p-3 bg-white no-print">
    <form method="GET" action="{{ url_for('reportes.jugador') }}" class="row g-3 align-items-end">
        <div class="col-md-4">
            <label for="id_equipo" class="form-label fw-bold small text-secondary">
                <i class="bi bi-shield text-success me-1"></i> Filtrar por Club:
            </label>
            <select name="id_equipo" id="id_equipo" class="form-select rounded-3 shadow-none border-secondary-subtle" onchange="this.form.submit()">
                <option value="">-- Todos los Clubes --</option>
                {% for eq in equipos %}
                    <option value="{{ eq.id_equipo }}" {{ eq.id_equipo == selected_equipo ? 'selected' : '' }}>
                        {{ eq.nombre }}
                    </option>
                {% endfor %}
            </select>
        </div>

        <div class="col-md-6">
            <label for="id_jugador" class="form-label fw-bold small text-secondary">
                <i class="bi bi-search text-primary me-1"></i> Seleccionar Jugador para Visualizar Ficha:
            </label>
            <select name="id_jugador" id="id_jugador" class="form-select rounded-3 shadow-none border-secondary-subtle" onchange="this.form.submit()">
                {% for j in jugadores %}
                    <option value="{{ j.id_jugador }}" {{ j.id_jugador == selected_jugador ? 'selected' : '' }}>
                        {{ j.nombres }} {{ j.apellidos }} — [{{ j.equipo_nombre }}]
                    </option>
                {% endfor %}
            </select>
        </div>

        <div class="col-md-2">
            <button type="submit" class="btn btn-primary rounded-3 w-100 fw-medium">
                <i class="bi bi-eye me-1"></i> Consultar
            </button>
        </div>
    </form>
</div>

{% if not detalle %}
    <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
        <div class="text-muted mb-3">
            <i class="bi bi-person-badge fs-1"></i>
        </div>
        <h5 class="fw-bold text-dark">No se ha seleccionado ningún jugador</h5>
        <p class="text-muted small mb-0">Utilice el selector superior para cargar la ficha y toda la información del jugador.</p>
    </div>
{% else %}
    {% set jug = detalle.jugador %}

    <!-- Ficha Principal de Identidad del Jugador (Requisito 4.d.i) -->
    <div class="card player-profile-card shadow-sm rounded-4 mb-4 p-4">
        <div class="row align-items-center g-4">
            <!-- Fotografía Destacada -->
            <div class="col-12 col-md-auto text-center">
                {% if jug.foto_url %}
                    <img src="{{ jug.foto_url }}" alt="{{ jug.nombres }} {{ jug.apellidos }}" class="profile-photo-hero" onerror="this.onerror=null;this.src='/uploads/jugadores/default.png';">
                {% else %}
                    <div class="profile-photo-hero bg-light text-muted d-flex align-items-center justify-content-center mx-auto fs-1 fw-bold">
                        {{ jug.nombres|slice(0, 1) }}{{ jug.apellidos|slice(0, 1) }}
                    </div>
                {% endif %}
                <div class="mt-2 text-center">
                    <span class="badge bg-secondary-subtle text-secondary border px-2.5 py-1 rounded-pill small">
                        ID: #{{ jug.id_jugador }}
                    </span>
                </div>
            </div>

            <!-- Información Biográfica y de Equipo -->
            <div class="col-12 col-md">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <span class="badge bg-dark text-white px-3 py-1 rounded-pill small">
                        Categoría Infantil
                    </span>
                    {% if detalle.tiene_suspension %}
                        <span class="badge status-pill-danger px-3 py-1 rounded-pill small">
                            <i class="bi bi-slash-circle-fill me-1"></i> SANCIÓN DISCIPLINARIA VIGENTE
                        </span>
                    {% else %}
                        <span class="badge status-pill-ok px-3 py-1 rounded-pill small">
                            <i class="bi bi-check-circle-fill text-success me-1"></i> HABILITADO PARA JUGAR
                        </span>
                    {% endif %}
                </div>

                <h2 class="fw-bold text-dark mb-1">{{ jug.nombres }} {{ jug.apellidos }}</h2>

                <!-- Club y Escudo -->
                <div class="d-flex align-items-center gap-2 mb-3">
                    {% if jug.equipo_foto_url %}
                        <img src="{{ jug.equipo_foto_url }}" alt="{{ jug.equipo_nombre }}" class="team-logo-sm rounded-circle" onerror="this.style.display='none'">
                    {% endif %}
                    <span class="h5 mb-0 fw-semibold text-secondary">{{ jug.equipo_nombre }}</span>
                </div>

                <!-- Detalle de Datos Personales en Grid -->
                <div class="row g-2 text-muted small">
                    <div class="col-sm-6">
                        <i class="bi bi-cake2 text-danger me-1"></i>
                        <strong>Fecha de Nacimiento:</strong> {{ jug.fecha_nacimiento|date('d/m/Y') }}
                    </div>
                    <div class="col-sm-6">
                        <i class="bi bi-hourglass-split text-primary me-1"></i>
                        <strong>Edad Actual:</strong> {{ jug.edad }} años
                    </div>
                    <div class="col-sm-6">
                        <i class="bi bi-calendar-plus text-success me-1"></i>
                        <strong>Fecha de Inscripción:</strong> {{ jug.creado_en|date('d/m/Y H:i') }}
                    </div>
                    <div class="col-sm-6">
                        <i class="bi bi-shield-check text-info me-1"></i>
                        <strong>Estado de Registro:</strong> Activo oficial
                    </div>
                </div>
            </div>
        </div>

        <!-- Banner de Advertencia si está suspendido -->
        {% if detalle.tiene_suspension %}
            <div class="alert alert-danger shadow-sm rounded-3 mt-4 mb-0 d-flex align-items-center gap-3" role="alert">
                <i class="bi bi-exclamation-octagon-fill fs-2 text-danger"></i>
                <div>
                    <h6 class="fw-bold mb-1">Aviso Disciplinario Oficial</h6>
                    <p class="mb-0 small">
                        Este jugador registra {{ detalle.suspensiones|length }} sanción(es) activa(s).
                        {% for susp in detalle.suspensiones %}
                            <span>Motivo: <strong>{{ susp.descripcion }}</strong> (Aplica para Jornada {{ susp.jornada_suspension_numero|default('por definir') }}).</span>
                        {% endfor %}
                    </p>
                </div>
            </div>
        {% endif %}
    </div>

    <!-- Indicadores Numéricos / KPIs del Jugador -->
    <div class="row g-3 mb-4">
        <!-- Goles Totales -->
        <div class="col-6 col-lg-3">
            <div class="kpi-box shadow-sm">
                <div class="text-success fs-3 mb-1"><i class="bi bi-dribbble"></i></div>
                <span class="text-muted small text-uppercase fw-semibold d-block">Goles Totales</span>
                <span class="h3 fw-bold text-dark mb-0">{{ detalle.total_goles }}</span>
                <small class="text-success d-block fw-medium">{{ detalle.historial_goles|length }} partido(s) anotando</small>
            </div>
        </div>

        <!-- Tarjetas Amarillas -->
        <div class="col-6 col-lg-3">
            <div class="kpi-box shadow-sm">
                <div class="text-warning fs-3 mb-1"><i class="bi bi-card-checklist"></i></div>
                <span class="text-muted small text-uppercase fw-semibold d-block">Tarjetas Amarillas</span>
                <span class="h3 fw-bold text-dark mb-0">{{ detalle.total_amarillas }}</span>
                <small class="text-muted d-block">Amonestaciones acumuladas</small>
            </div>
        </div>

        <!-- Tarjetas Rojas -->
        <div class="col-6 col-lg-3">
            <div class="kpi-box shadow-sm">
                <div class="text-danger fs-3 mb-1"><i class="bi bi-slash-circle-fill"></i></div>
                <span class="text-muted small text-uppercase fw-semibold d-block">Tarjetas Rojas</span>
                <span class="h3 fw-bold text-dark mb-0">{{ detalle.total_rojas }}</span>
                <small class="text-danger d-block fw-medium">Expulsiones directas</small>
            </div>
        </div>

        <!-- Frecuencia de Juego -->
        <div class="col-6 col-lg-3">
            <div class="kpi-box shadow-sm">
                <div class="text-primary fs-3 mb-1"><i class="bi bi-activity"></i></div>
                <span class="text-muted small text-uppercase fw-semibold d-block">Incidencias Totales</span>
                <span class="h3 fw-bold text-dark mb-0">{{ detalle.historial_incidencias|length }}</span>
                <small class="text-muted d-block">Intervenciones del árbitro</small>
            </div>
        </div>
    </div>

    <!-- Pestañas de Historial de Goles e Incidencias -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
        <ul class="nav nav-tabs px-3 pt-2 bg-light border-bottom" id="jugadorTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="goles-tab" data-bs-toggle="tab" data-bs-target="#goles-pane" type="button" role="tab" aria-controls="goles-pane" aria-selected="true">
                    <i class="bi bi-dribbble text-success me-1"></i> Historial de Goles ({{ detalle.historial_goles|length }})
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="incidencias-tab" data-bs-toggle="tab" data-bs-target="#incidencias-pane" type="button" role="tab" aria-controls="incidencias-pane" aria-selected="false">
                    <i class="bi bi-shield-exclamation text-warning me-1"></i> Historial Disciplinario ({{ detalle.historial_incidencias|length }})
                </button>
            </li>
        </ul>

        <div class="tab-content" id="jugadorTabsContent">
            <!-- Panel 1: Historial de Goles -->
            <div class="tab-pane fade show active p-0" id="goles-pane" role="tabpanel" aria-labelledby="goles-tab">
                {% if detalle.historial_goles is empty %}
                    <div class="p-5 text-center text-muted">
                        <i class="bi bi-info-circle fs-2 d-block mb-2"></i>
                        <h6 class="fw-bold text-dark">No registra goles anotados</h6>
                        <p class="small mb-0">El jugador aún no tiene goles asentados en las actas de partido.</p>
                    </div>
                {% else %}
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light text-secondary small text-uppercase fw-semibold">
                                <tr>
                                    <th class="ps-4">Jornada</th>
                                    <th>Fecha</th>
                                    <th>Partido Disputado</th>
                                    <th class="text-center" style="width: 150px;">Goles Anotados</th>
                                    <th class="text-end pe-4">Registrado el</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for g in detalle.historial_goles %}
                                    <tr>
                                        <td class="ps-4">
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1 rounded-pill">
                                                Jornada {{ g.numero_jornada }}
                                            </span>
                                        </td>
                                        <td class="fw-medium text-dark">{{ g.partido_fecha|date('d/m/Y') }}</td>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="fw-semibold text-dark">{{ g.local_nombre }}</span>
                                                <span class="text-muted small">vs</span>
                                                <span class="fw-semibold text-dark">{{ g.visita_nombre }}</span>
                                            </div>
                                            <small class="text-muted">{{ g.jornada_descripcion }}</small>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-success text-white px-3 py-1.5 rounded-pill fs-6 fw-bold">
                                                +{{ g.cantidad }} {{ g.cantidad == 1 ? 'gol' : 'goles' }}
                                            </span>
                                        </td>
                                        <td class="text-end pe-4 text-muted small">
                                            {{ g.creado_en|date('d/m/Y H:i') }}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>

            <!-- Panel 2: Historial Disciplinario -->
            <div class="tab-pane fade p-0" id="incidencias-pane" role="tabpanel" aria-labelledby="incidencias-tab">
                {% if detalle.historial_incidencias is empty %}
                    <div class="p-5 text-center text-muted">
                        <i class="bi bi-emoji-smile fs-2 text-success d-block mb-2"></i>
                        <h6 class="fw-bold text-dark">Historial Disciplinario Limpio</h6>
                        <p class="small mb-0">Este jugador no registra ninguna tarjeta amarilla ni expulsión en el torneo.</p>
                    </div>
                {% else %}
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light text-secondary small text-uppercase fw-semibold">
                                <tr>
                                    <th class="ps-4" style="width: 120px;">Fecha</th>
                                    <th>Partido / Jornada</th>
                                    <th class="text-center" style="width: 120px;">Tarjeta</th>
                                    <th>Motivo / Descripción</th>
                                    <th style="width: 220px;">Suspensión</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for inc in detalle.historial_incidencias %}
                                    <tr>
                                        <td class="ps-4 fw-medium text-dark">{{ inc.fecha_incidencia|date('d/m/Y') }}</td>
                                        <td>
                                            <span class="badge bg-light text-dark border mb-1">Jornada {{ inc.numero_jornada }}</span>
                                            <div class="small text-muted">{{ inc.local_nombre }} vs {{ inc.visita_nombre }}</div>
                                        </td>
                                        <td class="text-center">
                                            {% if inc.tipo_tarjeta == 'amarilla' %}
                                                <span class="badge bg-warning text-dark px-2.5 py-1 rounded-pill">
                                                    Amarilla
                                                </span>
                                            {% else %}
                                                <span class="badge bg-danger text-white px-2.5 py-1 rounded-pill">
                                                    Roja
                                                </span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            <small class="text-secondary">{{ inc.descripcion }}</small>
                                        </td>
                                        <td>
                                            {% if inc.id_jornada_suspension or inc.fecha_suspension %}
                                                <div class="p-1.5 rounded-2 bg-danger-subtle text-danger small border border-danger-subtle">
                                                    <i class="bi bi-slash-circle-fill me-1"></i>
                                                    Susp. Jornada {{ inc.jornada_suspension_numero|default('?') }}
                                                    {% if inc.fecha_suspension %}
                                                        <span class="d-block text-muted" style="font-size: 0.7rem;">Fecha: {{ inc.fecha_suspension|date('d/m/Y') }}</span>
                                                    {% endif %}
                                                </div>
                                            {% else %}
                                                <span class="badge bg-light text-muted border">Sin suspensión</span>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endif %}
{% endblock %}
