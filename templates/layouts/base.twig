<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ appName|default('Torneo Infantil de Fútbol') }}{% endblock %}</title>
    
    <!-- Bootstrap 5.3.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <style>
        :root {
            --soccer-primary: #0f5132;
            --soccer-secondary: #198754;
            --soccer-accent: #ffc107;
        }
        body {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            background-color: #f8f9fa;
        }
        .navbar-brand-badge {
            background: linear-gradient(135deg, #198754, #0f5132);
            color: #fff;
            padding: 4px 10px;
            border-radius: 8px;
            font-weight: 700;
        }
        .main-content {
            flex: 1 0 auto;
        }
        .footer {
            flex-shrink: 0;
            background-color: #ffffff;
            border-top: 1px solid #e9ecef;
        }
        .nav-link {
            font-weight: 500;
            transition: color 0.2s ease-in-out;
        }
        .nav-link:hover {
            color: var(--soccer-accent) !important;
        }
    </style>
    {% block styles %}{% endblock %}
</head>
<body>

    <!-- Barra de Navegación Principal -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top shadow-sm py-2">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" href="{{ url_for('home') }}">
                <i class="bi bi-trophy-fill text-warning fs-4"></i>
                <span class="fw-bold tracking-wide">Torneo<span class="text-success">GOL</span> Infantil</span>
            </a>
            
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Alternar navegación">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                    <li class="nav-item">
                        <a class="nav-link" href="{{ url_for('home') }}">
                            <i class="bi bi-house-door me-1"></i> Inicio
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/equipos">
                            <i class="bi bi-shield-shaded me-1"></i> Equipos
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/jugadores">
                            <i class="bi bi-people-fill me-1"></i> Jugadores
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/partidos">
                            <i class="bi bi-calendar3-event me-1"></i> Partidos
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/goles">
                            <i class="bi bi-dribbble me-1"></i> Goles
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/incidencias">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i> Incidencias
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/reportes">
                            <i class="bi bi-bar-chart-line-fill me-1"></i> Reportes
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Contenido Dinámico -->
    <main class="main-content py-4">
        <div class="container">
            {% block content %}{% endblock %}
        </div>
    </main>

    <!-- Pie de Página -->
    <footer class="footer py-3 text-muted">
        <div class="container d-flex flex-column flex-sm-row justify-content-between align-items-center text-center text-sm-start gap-2">
            <span class="small">&copy; {{ "now"|date("Y") }} {{ appName|default('Sistema de Torneo Infantil') }} - Todos los derechos reservados.</span>
            <span class="small text-secondary">
                Desarrollado con <i class="bi bi-heart-fill text-danger"></i> PHP 8.2, Slim Framework &amp; Twig
            </span>
        </div>
    </footer>

    <!-- Bootstrap 5.3.3 Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    {% block scripts %}{% endblock %}
</body>
</html>
