{% extends 'layouts/base.twig' %}

{% block title %}Partidos | {{ appName }}{% endblock %}

{% block content %}
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a href="{{ url_for('home') }}" class="text-decoration-none text-muted">Inicio</a></li>
                <li class="breadcrumb-item active" aria-current="page">Partidos</li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-0 text-dark">
            <i class="bi bi-calendar3-event text-info me-2"></i>Gestión de Partidos
        </h2>
        <p class="text-muted small mb-0">Programación del fixture por jornada. El marcador se calcula con los goles registrados.</p>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <a href="{{ url_for('jornadas.index') }}" class="btn btn-light shadow-sm rounded-3 px-3 py-2 fw-medium"
            style="--bs-btn-bg: #2fbf71; --bs-btn-border-color: #2fbf71; --bs-btn-hover-bg: #25a862; --bs-btn-hover-border-color: #25a862; --bs-btn-active-bg: #1f9455; --bs-btn-active-border-color: #1f9455; --bs-btn-color: #fff; --bs-btn-hover-color: #fff;">
            <i class="bi bi-flag me-1"></i> Gestionar Jornadas
        </a>
        <a href="{{ url_for('partidos.create') }}" class="btn btn-info text-white shadow-sm rounded-3 px-3 py-2 fw-medium">
            <i class="bi bi-plus-circle me-1"></i> Programar Partido
        </a>
    </div>
</div>

<!-- Filtros por Jornada y Equipo -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="GET" action="{{ url_for('partidos.index') }}" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted">
                        <i class="bi bi-flag"></i>
                    </span>
                    <select name="id_jornada" class="form-select border-start-0" onchange="this.form.submit()">
                        <option value="">-- Todas las Jornadas --</option>
                        {% for j in jornadas %}
                            <option value="{{ j.id_jornada }}" {% if selected_jornada == j.id_jornada %}selected{% endif %}>
                                Jornada {{ j.numero_jornada }} · {{ j.fecha_juego|date("d/m/Y") }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
            </div>

            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted">
                        <i class="bi bi-shield-shaded"></i>
                    </span>
                    <select name="id_equipo" class="form-select border-start-0" onchange="this.form.submit()">
                        <option value="">-- Todos los Equipos --</option>
                        {% for eq in equipos %}
                            <option value="{{ eq.id_equipo }}" {% if selected_equipo == eq.id_equipo %}selected{% endif %}>
                                {{ eq.nombre }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
            </div>

            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-secondary flex-grow-1 rounded-3">Filtrar</button>
                {% if selected_jornada or selected_equipo %}
                    <a href="{{ url_for('partidos.index') }}" class="btn btn-outline-secondary rounded-3" title="Limpiar filtros">
                        <i class="bi bi-x-lg"></i>
                    </a>
                {% endif %}
            </div>
        </form>
    </div>
</div>

{% if grupos is empty %}
    <div class="card border-0 shadow-sm rounded-4 p-5 text-center">
        <div class="my-4">
            <i class="bi bi-calendar-x display-1 text-muted opacity-50 mb-3 d-block"></i>
            <h4 class="fw-bold text-secondary">No se encontraron partidos</h4>
            <p class="text-muted small">
                {% if selected_jornada or selected_equipo %}
                    No hay resultados que coincidan con los filtros aplicados.
                {% elseif jornadas is empty %}
                    Aún no hay jornadas habilitadas. Las jornadas deben existir antes de programar partidos.
                {% else %}
                    Aún no hay partidos programados en el torneo.
                {% endif %}
            </p>
            {% if selected_jornada or selected_equipo %}
                <a href="{{ url_for('partidos.index') }}" class="btn btn-outline-secondary rounded-pill px-4 mt-2">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Restablecer Filtros
                </a>
            {% elseif jornadas is not empty %}
                <a href="{{ url_for('partidos.create') }}" class="btn btn-info text-white rounded-pill px-4 mt-2">
                    <i class="bi bi-plus-lg me-1"></i> Programar Primer Partido
                </a>
            {% else %}
                <a href="{{ url_for('jornadas.create') }}" class="btn btn-info text-white rounded-pill px-4 mt-2">
                    <i class="bi bi-plus-lg me-1"></i> Crear Primera Jornada
                </a>
            {% endif %}
        </div>
    </div>
{% else %}
    {% for g in grupos %}
        {% set jor = g.jornada %}
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
            <div class="card-header bg-white border-bottom px-4 py-3 d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                <div>
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-flag-fill text-info me-2"></i>Jornada {{ jor.numero_jornada }}
                    </h5>
                    <small class="text-muted">
                        <i class="bi bi-calendar3 me-1"></i>{{ jor.fecha_juego|date("d/m/Y") }}{% if jor.descripcion %} · {{ jor.descripcion }}{% endif %}
                    </small>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill">
                        {{ g.partidos|length }} {{ g.partidos|length == 1 ? 'partido' : 'partidos' }}
                    </span>
                    <a href="{{ url_for('partidos.create', {}, {'id_jornada': jor.id_jornada}) }}" class="btn btn-sm btn-outline-info rounded-3" title="Programar un partido en esta jornada">
                        <i class="bi bi-plus-lg"></i> Partido
                    </a>
                </div>
            </div>

            {% if g.partidos is empty %}
                <div class="p-4 text-center text-muted small">
                    <i class="bi bi-calendar-plus me-1"></i>Aún no hay partidos programados en esta jornada.
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-secondary small text-uppercase fw-semibold">
                            <tr>
                                <th class="ps-4 text-end" style="width: 32%;">Local</th>
                                <th class="text-center" style="width: 14%;">Marcador</th>
                                <th style="width: 32%;">Visitante</th>
                                <th class="text-center">Estado</th>
                                <th class="text-end pe-4">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for p in g.partidos %}
                                {% set tieneRegistros = (p.total_registros_gol + p.total_incidencias) > 0 %}
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center justify-content-end gap-2">
                                            <span class="fw-bold text-dark">{{ p.local_nombre }}</span>
                                            {% include 'partidos/_logo.twig' with {'foto': p.local_foto_url, 'nombre': p.local_nombre} only %}
                                        </div>
                                    </td>

                                    <td class="text-center">
                                        {% if p.total_registros_gol > 0 %}
                                            <span class="fs-5 fw-bold text-dark" title="Marcador según los goles registrados">{{ p.goles_local }} - {{ p.goles_visita }}</span>
                                        {% elseif p.estado == 'programado' %}
                                            <span class="fw-semibold text-muted">vs</span>
                                        {% else %}
                                            <span class="badge bg-light text-muted border rounded-pill" title="Todavía no se registraron goles en este partido">Sin goles registrados</span>
                                        {% endif %}
                                    </td>

                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            {% include 'partidos/_logo.twig' with {'foto': p.visita_foto_url, 'nombre': p.visita_nombre} only %}
                                            <span class="fw-bold text-dark">{{ p.visita_nombre }}</span>
                                        </div>
                                    </td>

                                    <td class="text-center">
                                        {% if p.estado == 'hoy' %}
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill">Hoy</span>
                                        {% elseif p.estado == 'jugado' %}
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">Jugado</span>
                                        {% else %}
                                            <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill">Programado</span>
                                        {% endif %}
                                    </td>

                                    <td class="text-end pe-4">
                                        <div class="d-flex justify-content-end gap-2">
                                            <a href="{{ url_for('partidos.show', {'id': p.id_partido}) }}" class="btn btn-sm btn-outline-info rounded-3 px-2.5" title="Ver hoja del partido">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a href="{{ url_for('partidos.edit', {'id': p.id_partido}) }}" class="btn btn-sm btn-outline-primary rounded-3 px-2.5" title="Editar Partido">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            {% if tieneRegistros %}
                                                <span class="d-inline-block" title="No se puede eliminar: tiene goles o incidencias registrados">
                                                    <button type="button" class="btn btn-sm btn-outline-danger rounded-3 px-2.5" disabled>
                                                        <i class="bi bi-trash3"></i>
                                                    </button>
                                                </span>
                                            {% else %}
                                                <button type="button" class="btn btn-sm btn-outline-danger rounded-3 px-2.5" title="Eliminar Partido"
                                                        data-bs-toggle="modal" data-bs-target="#modalEliminar"
                                                        data-action="{{ url_for('partidos.delete', {'id': p.id_partido}) }}"
                                                        data-partido="{{ p.local_nombre }} vs {{ p.visita_nombre }}">
                                                    <i class="bi bi-trash3"></i>
                                                </button>
                                            {% endif %}
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    {% endfor %}

    <p class="text-muted small text-end mb-0">
        Mostrando <strong>{{ total_partidos }}</strong> {{ total_partidos == 1 ? 'partido' : 'partidos' }}
    </p>
{% endif %}

<!-- Modal de confirmación para eliminar -->
<div class="modal fade" id="modalEliminar" tabindex="-1" aria-labelledby="modalEliminarLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-body p-4 text-center">
                <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-danger-subtle text-danger mb-3" style="width: 64px; height: 64px;">
                    <i class="bi bi-trash3 fs-2"></i>
                </span>
                <h5 class="fw-bold text-dark mb-2" id="modalEliminarLabel">¿Eliminar este partido?</h5>
                <p class="text-muted mb-1">Se eliminará <strong id="modalEliminarNombre" class="text-dark"></strong>.</p>
                <p class="text-muted small mb-4">Esta acción es irreversible.</p>
                <form id="formEliminar" method="POST" action="" class="d-flex justify-content-center gap-2">
                    <button type="button" class="btn btn-light rounded-3 px-4 fw-medium" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger rounded-3 px-4 fw-medium shadow-sm">
                        <i class="bi bi-trash3 me-1"></i> Sí, eliminar
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
document.getElementById('modalEliminar').addEventListener('show.bs.modal', function (event) {
    const boton = event.relatedTarget;
    document.getElementById('formEliminar').setAttribute('action', boton.getAttribute('data-action'));
    document.getElementById('modalEliminarNombre').textContent = boton.getAttribute('data-partido');
});
</script>
{% endblock %}