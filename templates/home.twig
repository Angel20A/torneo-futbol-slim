{% extends 'layouts/base.twig' %}

{% block title %}Inicio | {{ appName }}{% endblock %}

{% block content %}
<div class="row g-4 mb-4">
    <!-- Hero Banner -->
    <div class="col-12">
        <div class="p-5 rounded-4 bg-white border shadow-sm">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <h1 class="display-6 fw-bold text-dark mb-3">Gestión de Torneo Infantil de Fútbol</h1>
                    <p class="lead text-muted mb-3">
                        Sistema para la gestión de clubes, jugadores, partidos, goles, tarjetas e incidencias. El objetivo es facilitar el control del torneo.
                    </p>
                    <p class="lead text-muted mb-4">
                        Seleccione una opción de los siguientes módulos para comenzar.
                    </p>
                    <div class="d-flex flex-wrap gap-2">
                        <a href="#modulos" class="btn btn-success px-4 py-2 fw-medium rounded-3">
                            <i class="bi bi-grid-fill me-1"></i> Explorar Módulos
                        </a>
                    </div>
                </div>
                <div class="col-lg-4 text-center mt-4 mt-lg-0">
                    <div class="p-4 bg-light rounded-4 border">
                        <i class="bi bi-trophy display-1 text-warning mb-2"></i>
                        <h5 class="fw-bold mb-1">Liga Menor 2026</h5>
                        <p class="small text-muted mb-0">Plataforma Oficial de Gestión</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

