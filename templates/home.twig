<!-- Módulos del Sistema (Próximas Fases) -->
<div id="modulos" class="row g-3">
    <div class="col-12">
        <div class="d-flex align-items-center justify-content-between mb-2">
            <h4 class="fw-bold mb-0">Módulos del Torneo</h4>
            <!--<span class="text-muted small">Estructura preparada en <code>config/routes.php</code></span>-->
        </div>
    </div>

    <!-- Tarjeta Equipos -->
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 border-0 shadow-sm rounded-4 p-2">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="p-2 rounded-3 bg-success-subtle text-success fs-4">
                        <i class="bi bi-shield-shaded"></i>
                    </span>
                    <span class="badge bg-secondary-subtle text-secondary rounded-pill">Módulo 1</span>
                </div>
                <h5 class="fw-bold mb-2">Equipos</h5>
                <p class="text-muted small mb-3">Registro de clubes, categorías infantiles, logos y delegados oficiales.</p>
                <a href="/equipos" class="btn btn-sm btn-outline-success rounded-pill px-3">Ir a Equipos</a>
            </div>
        </div>
    </div>

    <!-- Tarjeta Jugadores -->
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 border-0 shadow-sm rounded-4 p-2">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="p-2 rounded-3 bg-primary-subtle text-primary fs-4">
                        <i class="bi bi-people-fill"></i>
                    </span>
                    <span class="badge bg-secondary-subtle text-secondary rounded-pill">Módulo 2</span>
                </div>
                <h5 class="fw-bold mb-2">Jugadores</h5>
                <p class="text-muted small mb-3">Fichas de niños/niñas, dorsales, edades, posiciones y fotografías.</p>
                <a href="/jugadores" class="btn btn-sm btn-outline-primary rounded-pill px-3">Ir a Jugadores</a>
            </div>
        </div>
    </div>

    <!-- Tarjeta Partidos -->
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 border-0 shadow-sm rounded-4 p-2">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="p-2 rounded-3 bg-info-subtle text-info fs-4">
                        <i class="bi bi-calendar-event-fill"></i>
                    </span>
                    <span class="badge bg-secondary-subtle text-secondary rounded-pill">Módulo 3</span>
                </div>
                <h5 class="fw-bold mb-2">Partidos &amp; Fixture</h5>
                <p class="text-muted small mb-3">Programación de jornadas, campos de juego, horarios y resultados finales.</p>
                <a href="/partidos" class="btn btn-sm btn-outline-info rounded-pill px-3">Ir a Partidos</a>
            </div>
        </div>
    </div>

    <!-- Tarjeta Goles -->
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 border-0 shadow-sm rounded-4 p-2">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="p-2 rounded-3 bg-warning-subtle text-warning-emphasis fs-4">
                        <i class="bi bi-dribbble"></i>
                    </span>
                    <span class="badge bg-secondary-subtle text-secondary rounded-pill">Módulo 4</span>
                </div>
                <h5 class="fw-bold mb-2">Goles &amp; Anotaciones</h5>
                <p class="text-muted small mb-3">Minuto a minuto de anotaciones, tabla de goleadores y premios.</p>
                <a href="/goles" class="btn btn-sm btn-outline-warning rounded-pill px-3">Ir a Goles</a>
            </div>
        </div>
    </div>

    <!-- Tarjeta Incidencias -->
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 border-0 shadow-sm rounded-4 p-2">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="p-2 rounded-3 bg-danger-subtle text-danger fs-4">
                        <i class="bi bi-exclamation-octagon-fill"></i>
                    </span>
                    <span class="badge bg-secondary-subtle text-secondary rounded-pill">Módulo 5</span>
                </div>
                <h5 class="fw-bold mb-2">Incidencias &amp; Fair Play</h5>
                <p class="text-muted small mb-3">Tarjetas amarillas, rojas, faltas disciplinarias y sanciones de árbitros.</p>
                <a href="/incidencias" class="btn btn-sm btn-outline-danger rounded-pill px-3">Ir a Incidencias</a>
            </div>
        </div>
    </div>

    <!-- Tarjeta Reportes -->
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 border-0 shadow-sm rounded-4 p-2">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="p-2 rounded-3 bg-dark-subtle text-dark fs-4">
                        <i class="bi bi-trophy"></i>
                    </span>
                    <span class="badge bg-secondary-subtle text-secondary rounded-pill">Módulo 6</span>
                </div>
                <h5 class="fw-bold mb-2">Reportes &amp; Posiciones</h5>
                <p class="text-muted small mb-3">Tabla general (PTS, PJ, PG, PE, PP, GF, GC, DIF) y reportes en PDF/Excel.</p>
                <a href="/reportes" class="btn btn-sm btn-outline-dark rounded-pill px-3">Ir a Reportes</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
