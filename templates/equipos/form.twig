{% extends 'layouts/base.twig' %}

{% set isEdit = equipo.id_equipo is defined and equipo.id_equipo %}
{% block title %}{{ title }} | {{ appName }}{% endblock %}

{% block content %}
<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item"><a href="{{ url_for('home') }}" class="text-decoration-none text-muted">Inicio</a></li>
                <li class="breadcrumb-item"><a href="{{ url_for('equipos.index') }}" class="text-decoration-none text-muted">Equipos</a></li>
                <li class="breadcrumb-item active" aria-current="page">{{ isEdit ? 'Editar' : 'Registrar' }}</li>
            </ol>
        </nav>

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-header bg-white border-bottom p-4">
                <div class="d-flex align-items-center gap-3">
                    <span class="p-2.5 rounded-3 bg-success-subtle text-success fs-4">
                        <i class="bi bi-shield-plus"></i>
                    </span>
                    <div>
                        <h4 class="fw-bold mb-0 text-dark">{{ isEdit ? 'Editar Equipo' : 'Nuevo Equipo' }}</h4>
                        <small class="text-muted">{{ isEdit ? 'Actualice los datos o el escudo del club' : 'Ingrese los datos del nuevo equipo participante' }}</small>
                    </div>
                </div>
            </div>

            <div class="card-body p-4">
                {% if errors is not empty %}
                    <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
                        <div class="d-flex align-items-center mb-1">
                            <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i>
                            <strong>Por favor corrija los siguientes errores:</strong>
                        </div>
                        <ul class="mb-0 ps-4 small">
                            {% for err in errors %}
                                <li>{{ err }}</li>
                            {% endfor %}
                        </ul>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                {% endif %}

                <form action="{{ isEdit ? '/equipos/' ~ equipo.id_equipo ~ '/editar' : '/equipos' }}" method="POST" enctype="multipart/form-data" novalidate>
                    <!-- Nombre del Equipo -->
                    <div class="mb-4">
                        <label for="nombre" class="form-label fw-semibold text-secondary">
                            Nombre del Equipo <span class="text-danger">*</span>
                        </label>
                        <input type="text" 
                               class="form-control form-control-lg rounded-3 fs-6" 
                               id="nombre" 
                               name="nombre" 
                               value="{{ equipo.nombre|default('') }}" 
                               placeholder="Ej. Deportivo Infantil FC" 
                               maxlength="100" 
                               required 
                               autofocus>
                        <div class="form-text">Nombre representativo único del club en la liga.</div>
                    </div>

                    <!-- Escudo / Foto del Equipo -->
                    <div class="mb-4">
                        <label for="foto" class="form-label fw-semibold text-secondary">
                            Escudo / Logo del Equipo
                        </label>
                        <input type="file" 
                               class="form-control rounded-3" 
                               id="foto" 
                               name="foto" 
                               accept="image/png, image/jpeg, image/webp, image/avif" 
                               onchange="previewImage(event)">
                        <div class="form-text">Formatos permitidos: JPG, PNG, WEBP, AVIF. Máx. 5 MB.</div>

                        <!-- Previsualización -->
                        <div class="mt-3 text-center p-3 bg-light rounded-3 border">
                            <div class="small text-muted mb-2 fw-medium">Vista previa del escudo:</div>
                            <img id="imagePreview" 
                                 src="{{ equipo.foto_url|default('') ?: 'https://placehold.co/120x120/e9ecef/6c757d?text=Sin+Escudo' }}" 
                                 alt="Escudo" 
                                 class="rounded-3 shadow-sm bg-white p-1 border" 
                                 style="max-width: 120px; max-height: 120px; object-fit: contain;">
                        </div>
                    </div>

                    <!-- Botones de Acción -->
                    <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                        <a href="{{ url_for('equipos.index') }}" class="btn btn-light rounded-3 px-4 fw-medium">
                            Cancelar
                        </a>
                        <button type="submit" class="btn btn-success rounded-3 px-4 fw-medium shadow-sm">
                            <i class="bi bi-check2-circle me-1"></i> {{ isEdit ? 'Guardar Cambios' : 'Registrar Equipo' }}
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
function previewImage(event) {
    const file = event.target.files[0];
    if (file) {
        const preview = document.getElementById('imagePreview');
        preview.src = URL.createObjectURL(file);
    }
}
</script>
{% endblock %}
